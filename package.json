    "@fontsource/righteous": "^5.3.0",
    "@fontsource/rubik-bubbles": "^5.3.0",
    "@fontsource/shrikhand": "^5.3.0",
    "@fontsource/sigmar-one": "^5.3.0",
    "@fontsource/sniglet": "^5.3.0",
    "@fontsource/titan-one": "^5.3.0",
    "@imgly/background-removal-data": "^1.4.5",
    "@tailwindcss/vite": "^4.3.3",

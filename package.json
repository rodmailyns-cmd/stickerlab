{
  "name": "stickerlab",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "assets": "node scripts/copy-fonts.mjs && node scripts/copy-bg-model.mjs",
    "predev": "npm run assets",
    "dev": "vite",
    "prebuild": "npm run assets",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "oxlint",
    "test": "vitest run",
    "test:android": "android/gradlew -p android/jvm-tests test",
    "e2e": "node scripts/e2e.mjs",
    "e2e:features": "node scripts/e2e-features.mjs",
    "e2e:native": "node scripts/e2e-native.mjs",
    "test:output": "vitest run tests/output.test.ts",
    "icons": "node scripts/make-icons.mjs && capacitor-assets generate --android",
    "android:sync": "npm run build && cap sync android",
    "android:open": "cap open android",
    "android:debug": "npm run android:sync && cd android && ./gradlew assembleDebug",
    "android:release": "npm run android:sync && cd android && ./gradlew assembleRelease bundleRelease"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/camera": "^8.2.6",
    "@capacitor/clipboard": "^8.0.1",
    "@capacitor/core": "^8.5.3",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/keyboard": "^8.0.6",
    "@capacitor/share": "^8.0.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@imgly/background-removal": "^1.4.5",
    "@jsquash/webp": "^1.5.0",
    "file-saver": "^2.0.5",
    "framer-motion": "^14.6.0",
    "gifuct-js": "^2.1.2",
    "idb": "^8.0.4",
    "immer": "^11.2.9",
    "jszip": "^3.10.2",
    "konva": "^10.9.0",
    "lucide-react": "^1.61.0",
    "nanoid": "^6.0.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.3",
    "@fontsource/amatic-sc": "^5.3.0",
    "@fontsource/anton": "^5.3.0",
    "@fontsource/archivo-black": "^5.3.0",
    "@fontsource/baloo-2": "^5.3.0",
    "@fontsource/bangers": "^5.3.0",
    "@fontsource/bebas-neue": "^5.3.0",
    "@fontsource/black-ops-one": "^5.3.0",
    "@fontsource/bungee": "^5.3.0",
    "@fontsource/caveat": "^5.3.0",
    "@fontsource/chewy": "^5.3.0",
    "@fontsource/creepster": "^5.3.0",
    "@fontsource/dancing-script": "^5.3.0",
    "@fontsource/fredoka": "^5.3.0",
    "@fontsource/gloria-hallelujah": "^5.3.0",
    "@fontsource/gochi-hand": "^5.3.0",
    "@fontsource/indie-flower": "^5.3.0",
    "@fontsource/lilita-one": "^5.3.0",
    "@fontsource/lobster": "^5.3.0",
    "@fontsource/luckiest-guy": "^5.3.0",
    "@fontsource/monoton": "^5.3.0",
    "@fontsource/montserrat": "^5.3.0",
    "@fontsource/nunito": "^5.3.0",
    "@fontsource/oswald": "^5.3.0",
    "@fontsource/pacifico": "^5.3.0",
    "@fontsource/patrick-hand": "^5.3.0",
    "@fontsource/permanent-marker": "^5.3.0",
